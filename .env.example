# Site URL — used for OG / Twitter card metadata (metadataBase)
NEXT_PUBLIC_SITE_URL=https://www.ning-xin.com

# Mapbox Configuration
# Get your token from: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Elastic Email — HTTP API key (server-side only, never expose to client)
# Get from: https://elasticemail.com → Settings → API Keys → Create API Key
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here
