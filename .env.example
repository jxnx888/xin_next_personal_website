# Site URL — used for OG / Twitter card metadata (metadataBase)
NEXT_PUBLIC_SITE_URL=https://www.ning-xin.com

# Elastic Email — HTTP API key (server-side only, never expose to client)
# Get from: https://elasticemail.com → Settings → API Keys → Create API Key
ELASTIC_EMAIL_API_KEY=your_elastic_email_api_key_here

# Notion Blog CMS (optional — falls back to public/mock/blogEN.json + blogCN.json)
# Get from: https://www.notion.so/my-integrations → Create integration → Internal Integration Secret
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Database ID from the Notion database URL: notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_BLOG_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# On-demand revalidation — protects /api/revalidate from unauthorized calls
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=your_random_secret_here
